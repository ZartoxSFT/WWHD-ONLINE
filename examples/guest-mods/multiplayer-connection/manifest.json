{
  "format_version": 1,
  "id": "multiplayer-connection",
  "name": "Wind Waker multiplayer connection",
  "version": "0.3.16",
  "game_id": "wwhd",
  "minimum_manager_version": "1.5.0",
  "kind": "guest",
  "guest": {
    "api_version": 1,
    "elf": "mod.elf",
    "heap_size": 8388608
  },
  "options": [
    {
      "id": "host",
      "type": "string",
      "name": "Server host",
      "default": "127.0.0.1"
    },
    {
      "id": "port",
      "type": "number",
      "name": "Server port",
      "default": 10014,
      "min": 1,
      "max": 65535
    },
    {
      "id": "uid",
      "type": "string",
      "name": "8-byte player identity",
      "default": "wwhduser"
    },
    {
      "id": "name",
      "type": "string",
      "name": "Player name shown to the others (1 to 16 ASCII characters, empty: J<id>)",
      "default": ""
    },
    {
      "id": "color",
      "type": "string",
      "name": "Tunic colour RRGGBB (empty: original)",
      "default": ""
    },
    {
      "id": "color2",
      "type": "string",
      "name": "Second tunic colour RRGGBB (empty: same)",
      "default": ""
    },
    {
      "id": "ship_color",
      "type": "string",
      "name": "Boat colour RRGGBB (empty: original)",
      "default": ""
    },
    {
      "id": "puppet",
      "type": "bool",
      "name": "Show remote players as Link (experimental)",
      "default": false
    },
    {
      "id": "hide_names",
      "type": "bool",
      "name": "Hide the names above the other players",
      "default": false
    },
    {
      "id": "hide_hud",
      "type": "bool",
      "name": "Hide the game's HUD (hearts, magic, rupees, buttons)",
      "default": false
    },
    {
      "id": "actors_see_puppets",
      "type": "bool",
      "name": "Enemies and residents react to the remote Link puppets as to the player",
      "default": true
    },
    {
      "id": "sync_actors",
      "type": "bool",
      "name": "Synchronise enemies and objects with the other players (server's list and enemy multiplier)",
      "default": true
    },
    {
      "id": "outfit",
      "type": "string",
      "name": "Clothes: auto (the save), hero or casual",
      "default": "auto"
    },
    {
      "id": "skin",
      "type": "string",
      "name": "Skin (skin_<id>.szs in the Data folder, empty: Link)",
      "default": ""
    },
    {
      "id": "hit_stop",
      "type": "bool",
      "name": "Keep the game's freeze when the sword hits (off: removed, as in the GameCube mod)",
      "default": false
    },
    {
      "id": "remote_tunics",
      "type": "bool",
      "name": "Remote Links wear their own tunic colours",
      "default": true
    }
  ]
}
